# Cable Guy - Umgebungsvariablen (Beispiel)
# Kopiere diese Datei zu `.env` und passe die Werte an deine lokale Konfiguration an.
# Wichtig: Da wir Vite nutzen, müssen alle clientseitig verfügbaren Variablen mit `VITE_` beginnen.

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION (Zukünftige Backend-Migration)
# ------------------------------------------------------------------------------
# Die URL deines Supabase-Projekts (z. B. https://xyz.supabase.co)
VITE_SUPABASE_URL=https://dein-projekt.supabase.co

# Der anonyme API-Schlüssel (public / safe for client-side)
VITE_SUPABASE_ANON_KEY=dein-anon-key-hier

# ------------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Der aktuelle Modus der App: "local" (für LocalStorage) oder "supabase" (für Cloud-Sync)
VITE_STORAGE_MODE=local
